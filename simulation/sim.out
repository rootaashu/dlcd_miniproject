    %jmp/0xz  T_2.4, 8;
    %load/vec4 v0x563ecbe34d90_0;
    %load/vec4 v0x563ecbe34f70_0;
    %parti/s 7, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x563ecbe34f70_0, 0;
T_2.4 ;
T_2.3 ;
T_2.1 ;
    %jmp T_2;
    .thread T_2;
    .scope S_0x563ecbe0ddc0;
T_3 ;
    %delay 5000, 0;
    %load/vec4 v0x563ecbe354a0_0;
    %inv;
    %store/vec4 v0x563ecbe354a0_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x563ecbe0ddc0;
T_4 ;
    %vpi_call/w 3 79 "$dumpfile", "simulation/waveform.vcd" {0 0 0};
    %vpi_call/w 3 80 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x563ecbe0ddc0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x563ecbe354a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x563ecbe35910_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x563ecbe35690_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x563ecbe35bb0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x563ecbe35780_0, 0, 8;
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x563ecbe35910_0, 0, 1;
    %vpi_call/w 3 90 "$display", "Enter an 8-bit binary number:" {0 0 0};
    %vpi_func 3 91 "$fscanf" 32, 32'b10000000000000000000000000000000, "%b", v0x563ecbe35c50_0 {0 0 0};
    %store/vec4 v0x563ecbe35a00_0, 0, 32;
    %load/vec4 v0x563ecbe35a00_0;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_4.0, 4;
    %vpi_call/w 3 94 "$display", "Input: %b", v0x563ecbe35c50_0 {0 0 0};
    %load/vec4 v0x563ecbe35c50_0;
    %store/vec4 v0x563ecbe352c0_0, 0, 8;
    %load/vec4 v0x563ecbe35c50_0;
    %inv;
    %addi 1, 0, 8;
    %store/vec4 v0x563ecbe353c0_0, 0, 8;
    %fork TD_tb_serial_complementer.test_input, S_0x563ecbe350d0;
    %join;
    %jmp T_4.1;
T_4.0 ;
    %vpi_call/w 3 98 "$display", "Invalid input!" {0 0 0};
T_4.1 ;
    %vpi_call/w 3 101 "$finish" {0 0 0};
    %end;
    .thread T_4;
