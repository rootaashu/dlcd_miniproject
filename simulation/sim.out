TD_tb_serial_complementer.test_input ;
    %wait E_0x563ecbdd3d50;
    %load/vec4 v0x563ecbe352c0_0;
    %store/vec4 v0x563ecbe35780_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x563ecbe35690_0, 0, 1;
    %wait E_0x563ecbe0f9a0;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x563ecbe35690_0, 0, 1;
    %vpi_call/w 3 50 "$display", "\012Input: %b", v0x563ecbe352c0_0 {0 0 0};
    %vpi_call/w 3 51 "$write", "Serial output (LSB first): " {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x563ecbe355b0_0, 0, 32;
T_0.0 ; Top of for-loop
    %load/vec4 v0x563ecbe355b0_0;
    %cmpi/s 8, 0, 32;
	  %jmp/0xz T_0.1, 5;
    %wait E_0x563ecbdd3d50;
    %vpi_call/w 3 56 "$write", "%b", v0x563ecbe35ac0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x563ecbe35bb0_0, 0, 1;
    %wait E_0x563ecbe0f9a0;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x563ecbe35bb0_0, 0, 1;
T_0.2 ; for-loop step statement
    %load/vec4 v0x563ecbe355b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x563ecbe355b0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %vpi_call/w 3 65 "$display", "\012Expected: %b", v0x563ecbe353c0_0 {0 0 0};
    %vpi_call/w 3 66 "$display", "Actual:   %b", v0x563ecbe35820_0 {0 0 0};
    %load/vec4 v0x563ecbe35820_0;
    %load/vec4 v0x563ecbe353c0_0;
    %cmp/e;
    %jmp/0xz  T_0.3, 6;
    %vpi_call/w 3 69 "$display", "RESULT: PASS" {0 0 0};
    %jmp T_0.4;
T_0.3 ;
    %vpi_call/w 3 71 "$display", "RESULT: FAIL" {0 0 0};
T_0.4 ;
    %end;
    .scope S_0x563ecbe12650;
T_1 ;
    %wait E_0x563ecbdd3ac0;
    %load/vec4 v0x563ecbe01e80_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x563ecbe346b0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x563ecbdfcc20_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.2, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x563ecbe346b0_0, 0;
    %jmp T_1.3;
T_1.2 ;
    %load/vec4 v0x563ecbe01de0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.4, 8;
    %load/vec4 v0x563ecbe346b0_0;
    %load/vec4 v0x563ecbe347c0_0;
    %or;
    %assign/vec4 v0x563ecbe346b0_0, 0;
T_1.4 ;
T_1.3 ;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x563ecbe0dff0;
T_2 ;
    %wait E_0x563ecbdd3ac0;
    %load/vec4 v0x563ecbe34c00_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x563ecbe34f70_0, 0;
    %jmp T_2.1;
T_2.0 ;
    %load/vec4 v0x563ecbe34a00_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.2, 8;
    %load/vec4 v0x563ecbe34aa0_0;
    %assign/vec4 v0x563ecbe34f70_0, 0;
    %jmp T_2.3;
T_2.2 ;
