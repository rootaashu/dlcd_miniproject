    %store/vec4 v0x55ce7e5c65a0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %vpi_call/w 3 62 "$display", "\012Expected: %b", v0x55ce7e5c63b0_0 {0 0 0};
    %vpi_call/w 3 63 "$display", "Actual:   %b", v0x55ce7e5c6810_0 {0 0 0};
    %load/vec4 v0x55ce7e5c6810_0;
    %load/vec4 v0x55ce7e5c63b0_0;
